# 개꿀 Doghoney - Environment Variables
# 이 파일을 복사하여 .env 파일을 만들고, 실제 키 값을 입력하세요.
# cp .env.example .env

# 1. VITE_GEMINI_API_KEY: Gemini Vision AI 사진 분석에 필요합니다.
# 발급: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. VITE_KAKAO_JS_KEY: 카카오 공유 & 로그인 JavaScript 앱 키
# 발급: https://developers.kakao.com/ → 앱 설정 > 앱 키 > JavaScript 키
VITE_KAKAO_JS_KEY="YOUR_KAKAO_JS_KEY_HERE"

# 3. Firebase 설정 (Firebase Console > 프로젝트 설정 > 내 앱 > firebaseConfig)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY_HERE"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID_HERE"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID_HERE"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# 4. APP_URL: 배포된 앱의 URL
APP_URL="https://www.doghoney.xyz"