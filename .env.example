# TrunkFit Environment Variables

# 1. VITE_GEMINI_API_KEY: Required for Gemini Vision AI photo analysis.
# Get your key at https://aistudio.google.com/app/apikey
# This is exposed to the client-side (VITE_ prefix) for direct API calls.
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. VITE_KAKAO_JS_KEY: Kakao Developers JavaScript App Key for KakaoTalk Feed Share & Login.
# Get your key at https://developers.kakao.com/ (앱 설정 > 앱 키 > JavaScript 키)
# If empty, the app runs in seamless Demo & Web Share API fallback mode.
VITE_KAKAO_JS_KEY=""

# 3. APP_URL: The URL where this applet is hosted.
APP_URL="https://trunkfit.kr"
